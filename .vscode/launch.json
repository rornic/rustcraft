    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'planetary_sandbox'",
            "cargo": {
                "args": [
                    "build",
                    "--example=planetary_sandbox"
                ]
            },
            "args": []
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in 'ochre-terrain'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=ochre-terrain"
                ],
                "filter": {
                    "name": "ochre_terrain",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}